{
  "Do block": {
    "prefix": "do",
    "body": [
      "do {",
      "\tlet ${1:value} <- ${2:effect};",
      "\t${0:value}",
      "}"
    ],
    "description": "Create a do block"
  },
  "Extern binding": {
    "prefix": "extern",
    "body": [
      "extern ${1:name}: ${2:type} = ${0:\"binding\"};"
    ],
    "description": "Declare an extern binding"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "\t$0",
      "}"
    ],
    "description": "Create a for loop"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:param}: ${3:type}) -> ${4:return_type} {",
      "\t$0",
      "}"
    ],
    "description": "Define a function"
  },
  "Function with functional dependency": {
    "prefix": "fnfd",
    "body": [
      "fn ${1:name}(${2:left}: ${3:'lhs}, ${4:right}: ${5:'rhs}) -> ${6:'out}",
      "where ${3:'lhs} ${5:'rhs} -> ${6:'out}: ${7:Trait}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Define a function constrained by a functional dependency"
  },
  "Function with where": {
    "prefix": "fnw",
    "body": [
      "fn ${1:name}(${2:value}: ${3:'a}) -> ${4:'a}",
      "where ${3:'a}: ${5:Trait}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Define a function with a where constraint"
  },
  "If expression": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "\t${2:then_value}",
      "} else {",
      "\t${0:else_value}",
      "}"
    ],
    "description": "Create an if expression"
  },
  "Impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "\tfn ${3:method}(${4:value}: ${2:Type}) -> ${5:return_type} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implement a trait"
  },
  "Impl with functional dependency": {
    "prefix": "implfd",
    "body": [
      "impl ${1:Trait} for ${2:Lhs}, ${3:Rhs} -> ${4:Out} {",
      "\tfn ${5:method}(${6:left}: ${2:Lhs}, ${7:right}: ${3:Rhs}) -> ${4:Out} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Implement a multi-parameter trait with a functional dependency"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "import \"${0:module}\""
    ],
    "description": "Import a Hern module"
  },
  "Inherent impl": {
    "prefix": "impli",
    "body": [
      "impl ${1:Type} {",
      "\tfn ${2:method}(${3:self}: ${1:Type}) -> ${4:return_type} {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Define inherent methods for a type"
  },
  "Let binding": {
    "prefix": "let",
    "body": [
      "let ${1:name} = ${0:value};"
    ],
    "description": "Create a let binding"
  },
  "Match expression": {
    "prefix": "match",
    "body": [
      "match ${1:value} {",
      "\t${2:Pattern} -> ${0:result},",
      "}"
    ],
    "description": "Create a match expression"
  },
  "Mutable let binding": {
    "prefix": "letm",
    "body": [
      "let mut ${1:name} = ${0:value};"
    ],
    "description": "Create a mutable let binding"
  },
  "Trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Trait} ${2:'a} {",
      "\tfn ${3:method}(${4:value}: ${2:'a}) -> ${5:bool}",
      "}"
    ],
    "description": "Define a trait"
  },
  "Trait with functional dependency": {
    "prefix": "traitfd",
    "body": [
      "trait ${1:Trait} ${2:'lhs} ${3:'rhs} -> ${4:'out} {",
      "\tfn ${5:method}(${6:left}: ${2:'lhs}, ${7:right}: ${3:'rhs}) -> ${4:'out}",
      "}"
    ],
    "description": "Define a multi-parameter trait with a functional dependency"
  },
  "Type definition": {
    "prefix": "type",
    "body": [
      "type ${1:Name} = ${0:Variant};"
    ],
    "description": "Define a type"
  }
}
